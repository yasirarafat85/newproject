# Copy this file to .env and fill in the values.
# .env must never be committed or placed inside public/.

# --- App ---
APP_NAME="FB Page Bot"
# Public HTTPS address of the bot subdomain, no trailing slash
APP_URL=https://bot.example.com
APP_TIMEZONE=Asia/Dhaka

# --- Admin panel ---
# Generate with: php bin/hash-password.php
# Keep the single quotes: the hash contains $ characters.
ADMIN_PASSWORD_HASH=''

# --- Database ---
# Path is relative to the fb-bot folder
DB_PATH=storage/app.sqlite

# --- Facebook Page (filled in Phase 1) ---
PAGE_NAME=
PAGE_ID=
# Filled automatically by: php bin/connect-page.php
PAGE_ACCESS_TOKEN=
# Meta dashboard → App settings → Basic
APP_ID=
APP_SECRET=
# Any random string; you type the same value in the Meta dashboard
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# --- Text AI (filled in Phase 2) ---
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=

# --- Behaviour ---
# true = log what the bot would reply, but never post to Facebook
DRY_RUN=true
# Max AI replies one person can get per hour
REPLIES_PER_USER_PER_HOUR=5
# Max AI replies per day across the whole Page
MAX_REPLIES_PER_DAY=300
# Shown to people when the bot cannot answer
HANDOFF_CONTACT=

# --- Privacy policy page (needed to switch the Meta App to Live) ---
PRIVACY_CONTACT_EMAIL=
